{
  "manifest_version": 3,
  "name": "WDSteam Reviews Translator",
  "version": "1.0.1",
  "description": "Translate Steam reviews and comments instantly, in any language, right inside the page.",
  "author": "Wdox",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "WDSteam Translate"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/app/*",
        "https://store.steampowered.com/*/app/*",
        "https://steamcommunity.com/app/*",
        "https://steamcommunity.com/id/*/recommended*",
        "https://steamcommunity.com/profiles/*/recommended*",
        "https://steamcommunity.com/comment/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
